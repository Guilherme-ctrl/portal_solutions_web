# Copie para .env.local para rodar localmente.
# Em produção, cadastre em: Vercel > Project > Settings > Environment Variables.
# Nenhuma destas variáveis é obrigatória para o site subir — sem elas, o
# recurso correspondente simplesmente não é ativado.

# ---------------------------------------------------------------------------
# Domínio canônico
# ---------------------------------------------------------------------------
# Usado em canonical, Open Graph e sitemap.xml.
# SEMPRE https e SEM www — www.portalsolutions.dev deve apenas redirecionar,
# nunca servir uma segunda cópia do site (ver README > "Domínio").
# O código normaliza o valor de qualquer forma: "http://" vira https e um
# "www." eventual é removido antes de virar canonical.
NEXT_PUBLIC_SITE_URL=https://portalsolutions.dev

# ---------------------------------------------------------------------------
# Formulário de /avaliar-projeto
# ---------------------------------------------------------------------------
# SEM o prefixo NEXT_PUBLIC_ de propósito: fica só no servidor e nunca é
# embutida no JavaScript entregue ao navegador.
#
# Formspree:  https://formspree.io/f/SEU_ID
# Formspark:  https://submit-form.com/SEU_ID
#
# Enquanto estiver vazia, o formulário responde com erro e oferece o WhatsApp.
FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Google Analytics 4 / Google Tag Manager
# ---------------------------------------------------------------------------
# Use GA_ID OU GTM_ID — configurar os dois duplica os eventos.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Google Ads — rastreamento de conversão
# ---------------------------------------------------------------------------
# ADS_ID: identificador da conta, no formato AW-000000000
# ADS_CONVERSION_LABEL: rótulo da conversão criada no painel do Ads
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
